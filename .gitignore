# ===========================================================================
# Python — runtime artifacts
# ===========================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# ===========================================================================
# Python — virtual environments
# ===========================================================================
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# pyenv — for a library/package, ignore so code can run in multiple envs;
# otherwise check it in.
# .python-version

# uv — generally recommended to include uv.lock in version control for
# binary packages; more commonly ignored for libraries.
# uv.lock

# ===========================================================================
# Python — test, coverage, type-check, lint
# ===========================================================================

# pytest + coverage
.pytest_cache/
.cache
.coverage
.coverage.*
htmlcov/
coverage.xml
cover/
*.cover
*.py.cover
.hypothesis/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# ===========================================================================
# Python — packaging / installer logs
# ===========================================================================
build/
dist/
.eggs/
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# PyPI upload credentials
.pypirc

# ===========================================================================
# Editor / IDE local state
# ===========================================================================

# Vim / emacs / sed -i backups and swap files — show up across contributor
# editors; never belong in the repo.
*~
*.swp
*.swo
.#*
\#*\#

# JetBrains — for a nuclear option uncomment to ignore the entire .idea folder.
# .idea/

# VS Code — uncomment to ignore the entire .vscode folder.
# .vscode/

# ===========================================================================
# OS / Filesystem metadata
# ===========================================================================

# macOS Finder — primary dev env is macOS; these slipped into the first
# skill copies and had to be filtered on import.
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Windows Explorer
Thumbs.db
ehthumbs.db
Desktop.ini

# ===========================================================================
# Node.js — npx-invoked formatters used by some skills
# ---------------------------------------------------------------------------
# Several skills (e.g. docs-steward) shell out to npx-installed formatters
# such as markdownlint-cli2, prettier, and remark. Local installs leave
# node_modules and tool logs behind that must not be committed.
# ===========================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===========================================================================
# Local-only env overrides / secrets
# ---------------------------------------------------------------------------
# Catch machine-specific overrides even when committed defaults exist.
# Anything ending in .local is treated as never-commit.
# ===========================================================================
.env.local
*.local
