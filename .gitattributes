# Normalize line endings on checkin; check out native.
* text=auto

# Force LF for scripts and configs.
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Treat common binaries as binary.
*.png binary
*.jpg binary
*.pdf binary

# Bundling manifest — exclude repo machinery from `git archive` exports.
# Skills ship as tracked content; repo tooling, tests, and internal planning docs do
# not. Root distributable/legal files (LICENSE, README, CHANGELOG, CODE_OF_CONDUCT)
# stay exportable, as does docs/adr/ (shipped docs link to it, so ignore only the
# internal planning files under docs/). The .github/ tree — including the security
# policy — is intentionally NOT shipped, so README links to SECURITY.md by absolute URL.
/.github                    export-ignore
/docs/delivery-plan.md      export-ignore
/docs/patches               export-ignore
/tests                      export-ignore
/.editorconfig              export-ignore
/.gitattributes             export-ignore
/.gitignore                 export-ignore
/.pre-commit-config.yaml    export-ignore
/.prettierrc.json           export-ignore
/.python-version            export-ignore
/pyproject.toml             export-ignore
/requirements-test.txt      export-ignore
/release-please-config.json export-ignore
/.release-please-manifest.json export-ignore
